# Generated by Cargo
# will have compiled files and executables
debug/
target/
.cursor/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Demo workspaces created by example shell scripts
demo/

# ── Bloxide codegen output ──────────────────────────────────────────
# All files in these directories are generated by `cargo blox generate`
# from blox.toml / system.toml. Only the tomls are committed.
**/src/generated/

# VS Code workspace settings emitted by `cargo blox generate`
# (rust-analyzer.linkedProjects for target/bloxide-generated/) — a fresh
# clone regenerates it with `cargo blox generate`.
/.vscode/settings.json

# Impl crates (crates/impl/*) belong to no workspace (root-excluded; cargo
# forbids out-of-tree membership in the generated workspace), so
# `cargo blox test` builds them standalone — their lockfiles stay local.
# (Their target/ dirs are covered by the global `target/` entry above.)
crates/impl/*/Cargo.lock

# Added by cargo
.hermes/
.codegraph/
.serena/

        "message": "peer_ref",
        "channel_capacity": null
      }
    ],
    "supervisors": [
      {
        "name": "bloxide-supervisor",
        "strategy": "when_any_done",
        "children": [
          {
            "actor": "ping",
            "restart_max": null,
            "stop": true
          },
          {
            "actor": "pong",
            "restart_max": null,
            "stop": true
          }
        ]
      }

  "message_sets": [],
  "messages": [],
  "actions": [],
  "context": null,
  "wiring": {
    "runtime": "tokio",
    "actors": [
      {
        "blox": "bloxide-timer",
        "name": "timer"
      },
      {
        "blox": "ping-blox",
        "name": "ping"
      },
      {
        "blox": "pong-blox",
        "name": "pong"
      }
